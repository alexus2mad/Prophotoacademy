[
  {
    "text": "Гарний кадр починається ще до натискання кнопки.",
    "start": 0.6,
    "end": 4.42
  },
  {
    "text": "З ідеї.",
    "start": 6.1,
    "end": 7.04
  },
  {
    "text": "З розуміння світла.",
    "start": 6.9,
    "end": 8.96
  },
  {
    "text": "З уроку, у якому все на своєму місці.",
    "start": 8.82,
    "end": 12.64
  },
  {
    "text": "Менеджер готує програму й матеріали.",
    "start": 12.5,
    "end": 15.68
  },
  {
    "text": "Обирає потрібні уроки.",
    "start": 17.1,
    "end": 18.92
  },
  {
    "text": "Відкриває доступ.",
    "start": 18.78,
    "end": 20.68
  },
  {
    "text": "І навчання вже у вашому кабінеті.",
    "start": 20.54,
    "end": 24.2
  },
  {
    "text": "Ви одразу знаєте, з чого почати.",
    "start": 25.6,
    "end": 27.98
  },
  {
    "text": "Один наступний крок — замість довгих пошуків.",
    "start": 27.84,
    "end": 32.86
  },
  {
    "text": "Читайте.",
    "start": 34.1,
    "end": 35.2
  },
  {
    "text": "Розглядайте деталі.",
    "start": 35.06,
    "end": 36.64
  },
  {
    "text": "Працюйте з матеріалами.",
    "start": 36.5,
    "end": 38.56
  },
  {
    "text": "Ваш прогрес зберігається, щоб наступного разу просто продовжити.",
    "start": 38.42,
    "end": 44.24
  },
  {
    "text": "Менше пошуку.",
    "start": 46.1,
    "end": 47.4
  },
  {
    "text": "Більше практики.",
    "start": 47.26,
    "end": 48.64
  },
  {
    "text": "ПроФото.",
    "start": 48.5,
    "end": 49.76
  },
  {
    "text": "Від знань — до вашого наступного кадру.",
    "start": 49.62,
    "end": 52.96
  }
]