[Unit]
Description=ProPhoto Academy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prophotoacademy
Group=prophotoacademy
WorkingDirectory=/srv/prophotoacademy/current
Environment=NODE_ENV=production
Environment=PORT=3140
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/etc/prophotoacademy/runtime.env
ExecStart=/opt/ps-booking-node/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3140
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/prophotoacademy
UMask=0077

[Install]
WantedBy=multi-user.target
