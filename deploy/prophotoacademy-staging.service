[Unit]
Description=ProPhoto Academy staging (isolated)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/prophotoacademy-staging/current/.next/BUILD_ID

[Service]
Type=simple
User=prophotoacademy-staging
Group=prophotoacademy-staging
WorkingDirectory=/srv/prophotoacademy-staging/current
Environment=NODE_ENV=production
Environment=PORT=3141
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/etc/prophotoacademy-staging/runtime.env
ExecStartPre=+/usr/bin/python3 /usr/local/lib/prophotoacademy/validate-staging.py
ExecStart=/opt/ps-booking-node/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3141
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/prophotoacademy-staging
InaccessiblePaths=/srv/prophotoacademy /etc/prophotoacademy
CPUQuota=75%
MemoryHigh=640M
MemoryMax=768M
TasksMax=128
UMask=0077

[Install]
WantedBy=multi-user.target
