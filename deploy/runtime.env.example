NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://staging.prophotoacademy.com.ua
NEXT_PUBLIC_ACADEMY_URL=https://staging.prophotoacademy.com.ua
NEXT_PUBLIC_HUB_URL=https://www.prophotohub.com.ua
PROPHOTO_SITE=academy
CONTENT_MODE=fixture
TRUST_PROXY=1
# Use the exact Session pooler host from Supabase Connect; preserve the restricted role.
DATABASE_URL=postgresql://prophoto_academy_runtime.PROJECT:PASSWORD@aws-INDEX-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
NODE_EXTRA_CA_CERTS=/etc/prophotoacademy/supabase-ca.crt
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ADMIN_EMAIL=alex.maksiutenko@gmail.com
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_LEARNING_DATASET=learning
SANITY_LEARNING_WRITE_TOKEN=
NEXT_PUBLIC_MANAGEMENT_URL=https://booking.plainstack.net/academy.html
NEXT_PUBLIC_CASHBOX_URL=https://booking.plainstack.net/admin.html?view=cashbox&channel=wayforpay
PS_BOOKING_MANAGEMENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=ProPhoto Academy <login@mail.prophotoacademy.com.ua>
CRON_SECRET=
# disabled grants published, mapped packages without charging; mock grants nothing.
# Paid activation requires wayforpay plus reviewed intake data and provider keys.
PAYMENT_MODE=disabled
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET=
WAYFORPAY_MERCHANT_DOMAIN=
NOTIFICATION_MODE=local
DATABASE_PATH=/srv/prophotoacademy/shared/academy.sqlite
