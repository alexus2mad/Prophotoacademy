[Unit]
Description=Deliver ProPhoto Academy transactional email
After=prophotoacademy.service

[Service]
Type=oneshot
User=prophotoacademy
Group=prophotoacademy
WorkingDirectory=/srv/prophotoacademy/current
EnvironmentFile=/etc/prophotoacademy/runtime.env
ExecStart=/opt/ps-booking-node/bin/node deploy/deliver-email.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=290
