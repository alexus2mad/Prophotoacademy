NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Set only by the isolated GitHub Pages review build.
NEXT_PUBLIC_REVIEW_MODE=
# Local default: Academy at / and Hub at /hub. Production: both public domains.
NEXT_PUBLIC_ACADEMY_URL=
NEXT_PUBLIC_HUB_URL=
# auto detects the configured Hub host; academy | hub selects a separate deployment.
PROPHOTO_SITE=auto
# Optional shared GA4 property. No analytics script loads before permission.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Separate server-only secrets, at least 32 characters. Never put these in URLs.
OPERATIONS_TOKEN=
ECOSYSTEM_INGEST_TOKEN=
# Explicit modes: fixture | sanity. Fixture is the reviewed migration snapshot.
CONTENT_MODE=fixture
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
# mock | wayforpay. No real transactions in mock mode.
PAYMENT_MODE=mock
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET=
WAYFORPAY_MERCHANT_DOMAIN=
MAKE_WEBHOOK_URL=
NOTIFICATION_MODE=local
# Set only behind a trusted proxy that replaces incoming forwarding headers.
TRUST_PROXY=0
# SQLite requires durable local storage on a Node host; not an ephemeral function.
DATABASE_PATH=.data/academy.sqlite

# Managed learning platform. Use the Supabase transaction pooler URL on Vercel.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ADMIN_EMAIL=alex.maksiutenko@gmail.com
# Separate private Sanity dataset; do not put paid lessons in the public marketing dataset.
SANITY_LEARNING_DATASET=learning
SANITY_LEARNING_READ_TOKEN=
SANITY_LEARNING_WRITE_TOKEN=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
# The shared cashbox and merchant-wide reporting belong to ps-booking.
# Optional override for its authenticated manager page. No credentials in this URL.
NEXT_PUBLIC_CASHBOX_URL=https://booking.plainstack.net/admin.html?view=cashbox&channel=wayforpay


