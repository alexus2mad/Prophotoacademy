NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Explicit modes: fixture | sanity. Fixture is the reviewed migration snapshot.
CONTENT_MODE=fixture
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
# mock | wayforpay. No real transactions in mock mode.
PAYMENT_MODE=mock
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET=
WAYFORPAY_MERCHANT_DOMAIN=
MAKE_WEBHOOK_URL=
NOTIFICATION_MODE=local
# Set only behind a trusted proxy that replaces incoming forwarding headers.
TRUST_PROXY=0
# SQLite requires durable local storage on a Node host; not an ephemeral function.
DATABASE_PATH=.data/academy.sqlite


